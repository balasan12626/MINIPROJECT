# MongoDB (local: mongodb://localhost:27017 | Docker Compose: mongodb://mongo:27017)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=flood_response

# Live weather / maps (never put real keys in source)
WEATHER_API_KEY=
OPENWEATHER_API_KEY=
TOMORROW_IO_API_KEY=
TOMTOM_API_KEY=
MAPS_API_KEY=
TRAFFIC_API_KEY=

# Optional LLM explanations for agents
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini voice agent (Live-capable key; keep secret)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# City
CITY_NAME=Delhi
CITY_LAT=28.6139
CITY_LON=77.2090
CITY_BBOX=28.4,76.8,28.9,77.4

# Decision policy (project settings, not scientific constants)
FLOOD_MONITOR_THRESHOLD=0.50
FLOOD_AUTO_THRESHOLD=0.60
AUTOMATION_ENABLED=true
HUMAN_OVERRIDE_ENABLED=true

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=changeme

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Models
MODEL_DIR=models
MODEL_LAZY_LOAD=true
